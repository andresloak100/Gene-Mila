cted_outcomes\\\": [\\n        \\\"Performance gradients across biological strata.\\\",\\n        \\\"Enrichment of known regulons in predicted top DE genes.\\\",\\n        \\\"Coherent clusters of predicted responses for related targets.\\\"\\n      ]\\n    },\\n    \\\"biological_mechanisms\\\": {\\n      \\\"mechanisms\\\": [\\n        \\\"Direct CRISPRi knockdown of the target transcript.\\\",\\n        \\\"Downstream regulon repression via transcription factor targets.\\\",\\n        \\\"Compensatory and stress responses (e.g., ribosome biogenesis, proteostasis).\\\",\\n        \\\"Cell-cycle and copy-number-associated expression shifts.\\\"\\n      ],\\n      \\\"investigation_approach\\\": \\\"Decompose predicted deltas into target-gene component, module components, and residual; relate modules to known pathways.\\\",\\n      \\\"validation_methods\\\": [\\n        \\\"Target-gene sign/magnitude checks.\\\",\\n        \\\"Module enrichment (MSigDB/GO) of top predicted DE genes.\\\",\\n        \\\"Comparison with observed deltas of related perturbations in training.\\\"\\n      ],\\n      \\\"expected_insights\\\": [\\n        \\\"Relative contribution of direct vs downstream effects.\\\",\\n        \\\"Which modules are most predictable across perturbations.\\\",\\n        \\\"Biological basis of prediction errors.\\\"\\n      ],\\n      \\\"biological_validation\\\": \\\"Confirm that predicted mechanisms align with known K562 biology and CRISPRi directionality (predominant repression).\\\"\\n    },\\n    \\\"experimental_validation\\\": {\\n      \\\"requirements\\\": [\\n        \\\"Held-out-perturbation CV as internal validation.\\\",\\n        \\\"External wet-lab validation optional but desirable for a subset of held-out perturbations.\\\",\\n        \\\"Controls: non-targeting guides, control mean, and target-only baseline.\\\"\\n      ],\\n      \\\"methods\\\": [\\n        \\\"Internal: leave-one-perturbation-out CV with official metrics.\\\",\\n     