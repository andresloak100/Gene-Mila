ility\": [\n          \"Penalize perturbations that conflict with known TF-target signatures\",\n          \"Project latent perturbation effects onto gene network modules for pathway-level interpretation\",\n          \"Report per-gene effect sizes and confidence intervals for all held-out perturbations\",\n          \"Use SHAP or integrated gradients to explain top predicted DE genes\"\n        ],\n        \"computational_efficiency\": [\n          \"Sparsify gene-gene adjacency matrices to top k neighbors\",\n          \"Use low-rank approximations for gene network embeddings\",\n          \"Cache control mean and variance estimates\",\n          \"Leverage mixed-precision training and batch splitting for large gene sets\"\n        ]\n      },\n      \"implementation_optimizations\": {\n        \"code_optimizations\": [\n          \"Vectorize pseudobulk mean and variance computations over sparse matrices\",\n          \"Use GPU-accelerated nearest neighbor and clustering where possible\",\n          \"Precompute gene-gene co-expression matrices once and reuse across models\",\n          \"Profile data loading and avoid repeated conversion between dense and sparse arrays\"\n        ],\n        \"pipeline_improvements\": [\n          \"Standardize normalization steps and store raw counts for valid pseudobulk recomputation\",\n          \"Create a reproducible train/validation split by perturbation rather than cell\",\n          \"Automate evaluation of all metrics in a single scoring script\",\n          \"Log model predictions, hyperparameters, and random seeds for traceability\"\n        ],\n        \"validation_enhancements\": [\n          \"Include multiple independent control sets for baseline comparison\",\n          \"Perform permutation tests to confirm delta correlation is above chance\",\n          \"Evaluate performance separately for strong and weak perturbations\",\n          \"Use bootstrap resampling over cells to estimate prediction confidence\"\n   