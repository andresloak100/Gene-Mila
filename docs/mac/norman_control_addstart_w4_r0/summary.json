 "most_useful_features": [
  {
   "feature": "response_components_e19",
   "experiment_id": "EXP_0019",
   "delta": 0.019898233587146152,
   "description": "Low-rank response components of the training perturbations (leave-one-out SVD of their centred delta profiles); p's weight on each component is predicted by kernel ridge from its target's annotations (gene-set memberships, protein interactions, TF-network partners). One column per component."
  },
  {
   "feature": "external_direct_replogle2022_k562_e21",
   "experiment_id": "EXP_0021",
   "delta": 0.0037475314758770306,
   "description": "External screen response of p's target (knowledge file replogle2022_k562): the change of gene g measured for the same target gene in another screen of the cell line (for a pair, the sum of its genes' rows), times the file's sign; 0 where unmeasured or without a row."
  },
  {
   "feature": "external_krr_replogle2022_k562_e23",
   "experiment_id": "EXP_0023",
   "delta": 0.0028659592174609116,
   "description": "Kernel transfer through an external screen (knowledge file replogle2022_k562): kernel ridge regression over the other training perturbations' responses, kernel = Pearson correlation between the external responses of their targets, so p's response is the mean training response plus a signed mix of the others' deviations from it; lambda chosen by leave-one-out over those training perturbations; the mean training response when p's target has no external row or fewer than 3 training perturbations have one."
  },
  {
   "feature": "target_level_e16",
   "experiment_id": "EXP_0016",
   "delta": 0.001108004923684569,
   "description": "Control mean expression of g if g is the perturbed target, else 0."
  },
  {
   "feature": "coexpr_target_e12",
   "experiment_id": "EXP_0012",
   "delta": 0.00017390671843353633,
   "description": "Control-cell correlation between the perturbed target gene and gene g."
  },
  {
   "feature": "control_variance_e18",
   "experiment_id": "EXP_0018",
   "delta": 0.00011731581566232219,
   "description": "Control-cell standard deviation of gene g."
  },
  {
   "feature": "additive_singles_e20",
   "experiment_id": "EXP_0020",
   "delta": 3.7593439472516366e-10,
   "description": "Additive model of single-gene responses: the sum over p's target genes of each gene's single-gene training response (the mean response of the other training perturbations whose one target is that gene), with the mean single-gene training response for a gene without one."
  }
 ],
