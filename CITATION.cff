    alias: andresloak100
    website: "https://github.com/andresloak100"
version: 0.1.0
date-released: "2026-10-18"
license: MIT
repository-code: "https://github.com/andresloak100/Gene-Mila"
keywords:
  - perturbation prediction
  - single-cell RNA-seq
  - gene expression
  - CRISPR screens
  - LLM agents
  - interpretable models
